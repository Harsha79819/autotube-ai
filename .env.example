# AutoTube AI - Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your values: cp .env.example .env

# ============================================================
# 1. MULTI-PROVIDER AI & MEDIA KEYS (Free Cascade Architecture)
# ============================================================
# Primary LLM: Google Gemini API (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# 1st LLM Fallback: Groq Cloud Llama 3.3 70B (100% Free, ~320 tok/s at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# 2nd LLM Fallback: OpenRouter Free Cascade (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Provider Cascade Priority Orders (Comma-separated)
LLM_PROVIDER_ORDER=gemini,groq,openrouter
IMAGE_PROVIDER_ORDER=pexels,pollinations

# Stock Media Providers
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# Voice Engine (options: edge | omnivoice | kokoro | xtts)
TTS_ENGINE=edge

# Optional Legacy OpenAI Key
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================
# 2. REMOTE ACCESS SECURITY (Required for Mobile Tunnel)
# ============================================================
# Numeric/Alphanumeric PIN required to unlock dashboard on mobile browsers
APP_PIN=8501

# ============================================================
# 3. PERMANENT STATIC REMOTE TUNNEL (Choose Option A or Option B)
# ============================================================

# Option A: Ngrok Free Permanent Static Domain (Recommended & 100% Free)
# Sign up at https://dashboard.ngrok.com and claim your 1 free permanent domain
NGROK_AUTHTOKEN=
NGROK_STATIC_DOMAIN=

# Option B: Cloudflare Zero Trust Named Tunnel Token
# Create at https://one.dash.cloudflare.com -> Networks -> Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
CLOUDFLARE_STATIC_DOMAIN=

# If neither Option A nor Option B is configured, AutoTube automatically
# falls back to a free Cloudflare Quick Tunnel (https://*.trycloudflare.com).
